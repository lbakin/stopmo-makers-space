# Copy to .env.local. Leave the project ID empty to run on the sample content.

# From sanity.io/manage, or printed by `npx sanity init`.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01

# Any long random string. The same string goes in the Sanity webhook's secret.
SANITY_REVALIDATE_SECRET=

# The public address once there's a domain, like https://example.com.
# Until then Netlify's own address is used.
SITE_URL=
